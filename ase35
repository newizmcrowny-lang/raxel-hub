local function notify(title, text, duration)
	pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = title or "Raxel Hub",
			Text = text or "",
			Duration = duration or 3
		})
	end)
end

local function loadKeys()
	local ok, result = pcall(function()
		return game:HttpGet(KEY_URL)
	end)

	if ok and result then
		for line in string.gmatch(result, "[^\r\n]+") do
			line = string.gsub(line, "^%s+", "")
			line = string.gsub(line, "%s+$", "")
			if line ~= "" then
				table.insert(VALID_KEYS, line)
			end
		end
	end
end

local function isValidKey(text)
	for _, key in ipairs(VALID_KEYS) do
		if text == key then
			return true
		end
	end
	return false
end

local function makeCorner(obj, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 12)
	c.Parent = obj
	return c
end

local function makeStroke(obj, thickness, color)
	local s = Instance.new("UIStroke")
	s.Thickness = thickness or 1.5
	s.Color = color or Color3.fromRGB(255,255,255)
	s.Parent = obj
	return s
end

local function rgbText(label)
	task.spawn(function()
		local h = 0
		while label and label.Parent do
			label.TextColor3 = Color3.fromHSV(h, 1, 1)
			h += 0.005
			if h >= 1 then
				h = 0
			end
			task.wait(0.03)
		end
	end)
end

local function rgbBackground(button)
	task.spawn(function()
		local h = 0
		while button and button.Parent do
			button.BackgroundColor3 = Color3.fromHSV(h, 0.85, 1)
			h += 0.004
			if h >= 1 then
				h = 0
			end
			task.wait(0.03)
		end
	end)
end

local function addHover(button, normalSize, hoverSize)
	button.MouseEnter:Connect(function()
		TweenService:Create(
			button,
			TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{Size = hoverSize}
		):Play()
	end)

	button.MouseLeave:Connect(function()
		TweenService:Create(
			button,
			TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{Size = normalSize}
		):Play()
	end)
end

local function shakeFrame(frame)
	local original = frame.Position
	for i = 1, 6 do
		frame.Position = original + UDim2.new(0, math.random(-8,8), 0, 0)
		task.wait(0.03)
	end
	frame.Position = original
end

