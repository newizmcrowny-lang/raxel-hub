-- HUB LOAD
local function loadHub()

	sendWebhook()

	local hub = Instance.new("ScreenGui", p.PlayerGui)

	local main = Instance.new("Frame", hub)
	main.Size = UDim2.new(0,800,0,520)
	main.Position = UDim2.new(0.5,-400,0.5,-600)
	main.BackgroundColor3 = Color3.fromRGB(20,20,20)
	main.BackgroundTransparency = 0.15
	Instance.new("UICorner", main)

	main:TweenPosition(
		UDim2.new(0.5,-400,0.5,-260),
		"Out","Quad",0.5,true
	)

	----------------
	-- SNOW EFFECT
	----------------

	local snowFolder = Instance.new("Folder", main)

	local function snow()
		local s = Instance.new("Frame", snowFolder)
		s.Size = UDim2.new(0,math.random(2,5),0,math.random(2,5))
		s.BackgroundColor3 = Color3.new(1,1,1)
		s.BorderSizePixel = 0
		s.Position = UDim2.new(0,math.random(0,800),0,-10)

		s:TweenPosition(
			UDim2.new(0,math.random(0,800),0,530),
			"Out","Linear",
			math.random(5,8),
			true,
			function()
				s:Destroy()
			end
		)
	end

	task.spawn(function()
		while main.Parent do
			snow()
			task.wait(0.1)
		end
	end)

	----------------
	-- HEADER
	----------------

	local header = Instance.new("Frame", main)
	header.Size = UDim2.new(1,0,0,50)
	header.BackgroundTransparency = 1

	local hubTitle = Instance.new("TextLabel", header)
	hubTitle.Size = UDim2.new(1,0,1,0)
	hubTitle.BackgroundTransparency = 1
	hubTitle.Text = "RAXEL HUB"
	hubTitle.Font = Enum.Font.GothamBlack
	hubTitle.TextSize = 26
	hubTitle.TextColor3 = Color3.new(1,1,1)

	----------------
	-- FPS FIX
	----------------

	local fpsLabel = Instance.new("TextLabel", main)
	fpsLabel.Size = UDim2.new(0,120,0,25)
	fpsLabel.Position = UDim2.new(1,-130,1,-35)
	fpsLabel.BackgroundTransparency = 1
	fpsLabel.Font = Enum.Font.GothamBold
	fpsLabel.TextSize = 16
	fpsLabel.Text = "FPS: 0"

	local frames = 0
	local last = tick()

	RunService.RenderStepped:Connect(function()

		frames += 1

		if tick() - last >= 1 then
			fpsLabel.Text = "FPS: "..frames
			frames = 0
			last = tick()
		end

	end)

	RGBLabel(fpsLabel)

end

