local function playOpenAnimation()
	main.Size = UDim2.new(0, 380, 0, 260)

	TweenService:Create(
		main,
		TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{
			Size = UDim2.new(0, 430, 0, 300),
			Position = UDim2.new(0.5, 0, 0.5, 0),
			BackgroundTransparency = 0
		}
	):Play()

	TweenService:Create(
		title,
		TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{TextTransparency = 0}
	):Play()

	TweenService:Create(
		subtitle,
		TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{TextTransparency = 0}
	):Play()

	TweenService:Create(
		keyBox,
		TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{
			BackgroundTransparency = 0,
			TextTransparency = 0
		}
	):Play()

	TweenService:Create(
		checkBtn,
		TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{
			BackgroundTransparency = 0,
			TextTransparency = 0
		}
	):Play()
end

local function playUnlockAnimation()
	local hide1 = TweenService:Create(
		keyBox,
		TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{
			BackgroundTransparency = 1,
			TextTransparency = 1
		}
	)

	local hide2 = TweenService:Create(
		checkBtn,
		TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{
			BackgroundTransparency = 1,
			TextTransparency = 1
		}
	)

	local hide3 = TweenService:Create(
		subtitle,
		TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
		{TextTransparency = 1}
	)

	hide1:Play()
	hide2:Play()
	hide3:Play()

	task.wait(0.22)

	keyPanel.Visible = false
	subtitle.Visible = false
	content.Visible = true

	tpBlockBtn.Size = UDim2.new(0, 240, 0, 48)
	tpBlockBtn.TextTransparency = 1
	tpBlockBtn.BackgroundTransparency = 1

	local showBtn = TweenService:Create(
		tpBlockBtn,
		TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
		{
			Size = UDim2.new(0, 300, 0, 56),
			TextTransparency = 0,
			BackgroundTransparency = 0
		}
	)
	showBtn:Play()
end

