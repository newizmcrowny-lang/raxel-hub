-- ✅ SADECE COOLDOWN EKLENMİŞ HAL
checkBtn.MouseButton1Click:Connect(function()

	if keyCooldown then
		notify("Raxel Hub", "3 saniye bekle.", 2)
		return
	end

	if isValidKey(keyBox.Text) then
		unlocked = true
		keyPanel.Visible = false
		subtitle.Visible = false
		content.Visible = true
		notify("Raxel Hub", "Key accepted.", 3)
	else
		keyCooldown = true
		notify("Raxel Hub", "Invalid key.", 3)
		shakeFrame(main)

		task.delay(3, function()
			keyCooldown = false
		end)
	end

end)

tpBlockBtn.MouseButton1Click:Connect(function()
	if not unlocked then
		notify("Raxel Hub", "Önce key girmen gerekiyor.", 3)
		return
	end

	loadstring(game:HttpGet('https://pastebin.com/raw/gZMGfTfx'))()
end)
